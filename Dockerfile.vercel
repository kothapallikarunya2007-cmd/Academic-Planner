FROM maven:3.9.11-eclipse-temurin-25 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn --batch-mode --no-transfer-progress verify

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /build/target/campus-connect-1.0.0.jar /app/app.jar
ENV APP_ENV=production BIND_ADDRESS=0.0.0.0 SECURE_COOKIE=true SEED_DEMO=false
EXPOSE 8080
CMD ["java", "-jar", "/app/app.jar"]
