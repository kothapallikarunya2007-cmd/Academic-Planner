{
  "info": {
    "name": "Campus Connect API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Login admin first. Cookies are managed by Postman. Record creation requests change the local database; use once or change unique names."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
